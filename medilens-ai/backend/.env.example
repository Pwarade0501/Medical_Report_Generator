# Copy this file to .env and adjust. Never commit .env.
APP_NAME=MediLens AI
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Report upload (Phase 2) ---
# Maximum upload size in megabytes (must be > 0)
MAX_UPLOAD_SIZE_MB=10
# Local development storage. Relative paths resolve against the backend/ folder.
REPORT_STORAGE_PATH=storage/reports

# --- Optional Phase 6 AI explanations (OpenAI API usage may incur charges) ---
# Leave blank to keep the AI explanation endpoint disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=20
